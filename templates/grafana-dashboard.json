{
  "title": "RAPA 웹 가용성 데모",
  "uid": "rapa-availability",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "browser",
  "panels": [
    {
      "type": "state-timeline",
      "title": "서비스 가용성 · VIP (로드밸런싱)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 85, "lineWidth": 0 },
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] },
          "mappings": [ { "type": "range", "options": { "from": 0.5, "to": 1000000, "result": { "text": "UP", "color": "green", "index": 0 } } }, { "type": "range", "options": { "from": -1000000, "to": 0.5, "result": { "text": "DOWN", "color": "red", "index": 1 } } } ]
        },
        "overrides": []
      },
      "options": { "mergeValues": true, "showValue": "always", "rowHeight": 0.9, "alignValue": "center", "legend": { "showLegend": false } },
      "targets": [
        { "refId": "A", "expr": "probe_success{probe_role=\"vip\"}", "legendFormat": "VIP" }
      ]
    },
    {
      "type": "state-timeline",
      "title": "서비스 가용성 · victim (단일 서버)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 85, "lineWidth": 0 },
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] },
          "mappings": [ { "type": "range", "options": { "from": 0.5, "to": 1000000, "result": { "text": "UP", "color": "green", "index": 0 } } }, { "type": "range", "options": { "from": -1000000, "to": 0.5, "result": { "text": "DOWN", "color": "red", "index": 1 } } } ]
        },
        "overrides": []
      },
      "options": { "mergeValues": true, "showValue": "always", "rowHeight": 0.9, "alignValue": "center", "legend": { "showLegend": false } },
      "targets": [
        { "refId": "A", "expr": "probe_success{probe_role=\"victim\"}", "legendFormat": "victim" }
      ]
    },
    {
      "type": "state-timeline",
      "title": "백엔드 UP/DOWN (web1/2/3)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 85, "lineWidth": 0 },
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] },
          "mappings": [ { "type": "range", "options": { "from": 0.5, "to": 1000000, "result": { "text": "UP", "color": "green", "index": 0 } } }, { "type": "range", "options": { "from": -1000000, "to": 0.5, "result": { "text": "DOWN", "color": "red", "index": 1 } } } ]
        },
        "overrides": []
      },
      "options": { "mergeValues": true, "showValue": "always", "rowHeight": 0.9, "alignValue": "center", "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "refId": "A", "expr": "max by (server) (haproxy_server_status{proxy=\"web_pool\",state=\"UP\"})", "legendFormat": "{{server}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "요청률 roundrobin (web1/2/3)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (server) (rate(haproxy_server_sessions_total{proxy=\"web_pool\"}[1m]))", "legendFormat": "{{server}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "노드 CPU 사용률 %",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "drawStyle": "line", "fillOpacity": 15 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "100 - (avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)", "legendFormat": "{{instance}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "노드 메모리 사용률 % (victim OOM 관측)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "drawStyle": "line", "fillOpacity": 15 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100", "legendFormat": "{{instance}}" }
      ]
    }
  ]
}
