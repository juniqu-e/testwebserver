# Prometheus 설정 (RAPA 데모). 대상은 roles/monitor.sh 가 주입한다:
#   @@HAPROXY_TARGETS@@  lb 들의 :8405  (예: '10.0.0.180:8405','10.0.0.181:8405')
#   @@NODE_TARGETS@@     node_exporter :9100 대상들
global:
  scrape_interval: 5s
  evaluation_interval: 5s

scrape_configs:
  - job_name: 'haproxy'
    metrics_path: /metrics
    static_configs:
      - targets: [@@HAPROXY_TARGETS@@]

  - job_name: 'node'
    static_configs:
      - targets: [@@NODE_TARGETS@@]

  # 가용성 프로브: 대상 URL 이 200 을 주는지 직접 확인 (victim vs VIP 생사)
  - job_name: 'blackbox'
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - targets: [@@PROBE_TARGETS@@]
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: 127.0.0.1:9115

  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']
